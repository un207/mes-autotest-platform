# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- pytest ----
.pytest_cache/
.coverage
htmlcov/

# ---- 报告产出（可随时重新生成，不进仓库） ----
# 注意 history/ 不在此列：执行历史是累积资产，必须进仓库，否则通过率趋势无从谈起
reports/

# ---- 临时文件（试跑验证、样本数据等） ----
.tmp/

# ---- 运行日志（排障用，属临时文件） ----
*.log

# ---- IDE ----
.idea/
.vscode/
*.iml
